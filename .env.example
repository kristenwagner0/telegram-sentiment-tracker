# Environment variables for SentimentTrack (copy to .env for local dev).
#
# Portfolio hosting (Render.com):
#   PORTFOLIO_MODE=1       — synthetic demo only, hides real-data nav items
#   DEMO_SHEET_URL         — public Google Sheet CSV URL for synthetic demo
#   GITHUB_REPO_URL        — shown in dashboard sidebar and Get the tool page
#   CONTACT_EMAIL          — optional contact on Get the tool page
#
# Local analysis (optional):
#   GOOGLE_SHEET_ID        — target sheet for --push-sheets
#   GOOGLE_CREDENTIALS_PATH — service account JSON for Sheets API

# Portfolio demo hosting (Render.com)
PORTFOLIO_MODE=1
DEMO_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=0
GITHUB_REPO_URL=https://github.com/kristenwagner0/telegram-sentiment-tracker
CONTACT_EMAIL=you@example.com

# Local analysis (optional)
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_PATH=
